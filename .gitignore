# ============================================================
# Terraform
# ============================================================

.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform.lock.hcl.backup
crash.log
crash.*.log

# IMPORTANT:
# .terraform.lock.hcl is intentionally NOT ignored.
# It must be committed for Terraform provider reproducibility.

